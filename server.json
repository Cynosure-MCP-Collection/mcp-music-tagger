{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.andreasjhagen/music-tagger",
  "description": "Identify and tag music with AcoustID fingerprints and MusicBrainz metadata",
    "version": "1.0.5",
    "icons": [
        {
            "src": "https://unpkg.com/@cynosure-mcp/music-tagger@1.0.5/icon.png",
            "mimeType": "image/png"
        }
    ],
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@cynosure-mcp/music-tagger",
            "version": "1.0.5",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": [
                {
                    "name": "ACOUSTID_API_KEY",
                    "description": "Free API key from https://acoustid.org/api-key (required for fingerprinting)",
                    "required": true
                }
            ]
        }
    ],
    "repository": {
        "url": "https://github.com/Cynosure-MCP-Collection/mcp-music-tagger",
        "source": "github"
    }
}
