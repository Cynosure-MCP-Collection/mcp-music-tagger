{
  "name": "@cynosure-mcp/music-tagger",
  "mcpName": "io.github.andreasjhagen/music-tagger",
  "version": "1.0.4",
  "description": "MCP server for identifying and tagging music files via AcoustID fingerprinting and MusicBrainz metadata",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "music-tagger": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "release:check": "node scripts/sync-version.mjs --check",
    "version": "node scripts/sync-version.mjs && git add server.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "node-taglib-sharp": "^3.3.0",
    "rusty-chromaprint-wasm": "^0.1.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "server.json",
    "icon.png"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "music",
    "tags",
    "id3",
    "acoustid",
    "musicbrainz",
    "fingerprint"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cynosure-MCP-Collection/mcp-music-tagger.git"
  },
  "homepage": "https://github.com/Cynosure-MCP-Collection/mcp-music-tagger#readme",
  "bugs": {
    "url": "https://github.com/Cynosure-MCP-Collection/mcp-music-tagger/issues"
  }
}
